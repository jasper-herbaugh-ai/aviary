NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aviary
MIGRATE_ON_STARTUP=true
API_PORT=4000
JWT_SECRET=change-me
CREDENTIAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
# Optional fallback values. Prefer configuring OIDC in the web UI under
# Automation Settings -> Security (stored in app_config).
# OIDC_ISSUER_URL=http://localhost:9000/application/o/aviary/
# OIDC_CLIENT_ID=aviary-client
# OIDC_CLIENT_SECRET=aviary-secret
# OIDC_REDIRECT_URI=http://localhost:4000/api/v1/auth/oidc/callback
LOCAL_BOOTSTRAP_ADMIN=true
LOCAL_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
LOCAL_BOOTSTRAP_ADMIN_PASSWORD=change-me
# Optional: initial default; can be saved in DB during first-run setup.
TOTP_ISSUER=Aviary
# WebAuthn values are optional; API can infer these from incoming requests.
# Set these explicitly in production/proxy environments for deterministic behavior.
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_NAME=Aviary
# WEBAUTHN_ORIGIN=http://localhost:3000
PGBOSS_SCHEMA=pgboss
PGBOSS_QUEUE=playbook-jobs
INTERNAL_API_TOKEN=internal-token
WORKER_API_BASE_URL=http://localhost:4000
WORKER_POLL_INTERVAL_MS=2000
WORKER_CONCURRENCY=5

# Optional overrides. Defaults are:
# API_GRPC_PORT=50051
# WORKER_API_GRPC_TARGET=<host from WORKER_API_BASE_URL>:50051
